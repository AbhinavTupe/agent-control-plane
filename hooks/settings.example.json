{
  "hooks": {
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "python3 /ABSOLUTE/PATH/agent-control-plane/hooks/acp_hook.py", "timeout": 60 }
        ]
      }
    ],
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "python3 /ABSOLUTE/PATH/agent-control-plane/hooks/acp_hook.py", "timeout": 5 } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "python3 /ABSOLUTE/PATH/agent-control-plane/hooks/acp_hook.py", "timeout": 5 } ] }
    ]
  }
}
